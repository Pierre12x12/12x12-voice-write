{
  "name": "12x12-voice-write",
  "version": "1.0.3",
  "description": "12x12 Voice Write - Sprache zu Text per Hotkey, mit KI-Korrektur",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "form-data": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.12x12.voicewrite",
    "productName": "12x12 Voice Write",
    "artifactName": "12x12-Voice-Write-Setup-${version}.${ext}",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "12x12 Voice Write"
    },
    "publish": {
      "provider": "github",
      "owner": "Pierre12x12",
      "repo": "12x12-voice-write"
    }
  }
}
